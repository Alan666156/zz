# Copy to .env.local (gitignored) and fill in local values.
# Never commit real passwords or keys.
#
# Generate independent 64-hex-char secrets:
#   openssl rand -hex 32

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=zz_dev
DB_USERNAME=root
DB_PASSWORD=replace-with-local-password

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-local-password
REDIS_DATABASE=0

# Device id pepper: HMAC-SHA256 key, never stored in the database.
APP_DEVICE_PEPPER=replace-with-openssl-rand-hex-32
# CSV export token key: independent from the device pepper.
APP_EXPORT_TOKEN_KEY=replace-with-another-openssl-rand-hex-32

APP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
SERVER_PORT=8080

# Optional fixed-window rate-limit overrides (defaults shown).
# APP_RATE_LIMIT_API_PER_MINUTE=120
# APP_RATE_LIMIT_INIT_PER_HOUR=10
# APP_RATE_LIMIT_EXPORT_PER_HOUR=5
# APP_RATE_LIMIT_SYNC_PER_MINUTE=30
