# 复制为 .env.local 后按需修改；.env.local 已被 .gitignore 忽略。
# 本文件只放占位符，禁止提交真实密码/密钥。

# 服务地址
API_BASE_URL=http://127.0.0.1:8080
WEB_BASE_URL=http://127.0.0.1:4173

# MySQL（仅测试库 zz_e2e，脚本会拒绝其他库名）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_NAME=zz_e2e
DB_PASSWORD=

# Redis（仅 E2E 库 14，脚本会拒绝其他 DB）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=14
REDIS_PASSWORD=

# 仅 TE-02 测试“过期/篡改导出 token”时需要；必须是测试实例专用密钥，
# 与生产 APP_EXPORT_TOKEN_KEY 不同。不得写入仓库。
APP_EXPORT_TOKEN_KEY=

# 限流专项用例开关（默认不跑，见 README）
RUN_RATE_LIMIT=0
